.venv/
__pycache__/
*.py[cod]

# Downloaded embeddings.  glove.6B.zip is 862 MB, over GitHub's 100 MB
# per-file limit, and both files are reproducible by the Task 2 script.
data/glove.6B.zip
data/glove.6B.100d.txt

# Derived, regenerated by the scripts.  `splits/*.csv` duplicates the corpus
# three ways but is reproducible from make_splits.py plus the seed, so only
# splits/meta.json (which records the exact indices) is committed.  cache/
# holds tokenisation pickles and trained Word2Vec models.
cache/
*.pkl
splits/*.csv

# Internal working material: the assistant's own audit log, and the chat
# transcript this project was worked out in.  Neither is part of the
# submission.
artifacts/
.chats/

# LaTeX build products
report/build/
*.aux
*.log
*.fls
*.fdb_latexmk
*.out
*.synctex.gz
